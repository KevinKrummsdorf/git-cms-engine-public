# =====================================================================
# Environment Configuration Template for the Git-Backed Headless CMS Engine
# 
# Rename this file to '.env' and populate appropriate values for deployment.
# All settings are read via config.py (Pydantic BaseSettings).
# Do not commit secrets or raw passwords directly to version control.
# =====================================================================

# --- Git Repository Configuration ---
# Set to 'True' to skip all remote Git network processes and read directly from local files.
# Convenient for rapid offline development, local debugging, or standalone testing.
CMS_USE_LOCAL_CONTENT=False

# The remote Git clone URL containing target Markdown documents and resource subdirectories.
# Supports public HTTPS repositories or SSH paths.
CMS_GIT_URL=https://github.com/KevinKrummsdorf/my-docs

# Optional Personal Access Token (PAT) used to authenticate against private Git repositories.
# This value is managed strictly in memory and is never written to disk or logged.
CMS_GIT_PAT=

# The targeted Git repository branch sequence to check out and synchronize.
CMS_GIT_BRANCH=main

# Local file system cache path where the Git working copy is fetched and checked out.
CMS_REPO_LOCAL_PATH=./.cms_repo_cache


# --- Data Paths (Dual-Volume Architecture) ---
# Absolute target path within the container where raw Git repository data resides.
CMS_RAW_DATA_PATH=/app/raw_data

# Target folder destination where processed and compiled Markdown files are output.
# This directory is mounted statically under the '/data' route by the FastAPI application.
CMS_PROCESSED_DATA_PATH=/app/data

# Optional comma-separated folder subdirectories under raw 'content/' directory.
# Only documents residing within these paths will undergo processing; others are logged and ignored.
# Example: security/grc,network/infra
CMS_ALLOWED_FOLDERS=


# --- Webhook Sync Authentication ---
# Shared secret key string checked when validating incoming webhook requests at POST /api/v1/cms/sync.
# Incoming header 'X-CMS-Sync-Secret' must match this secret value exactly.
# Also used as the HMAC-SHA256 signature key when validating GitHub 'X-Hub-Signature-256' headers.
CMS_SYNC_SECRET=changeme


# --- Database Configurations ---
# Connection string syntax for SQLAlchemy PostgreSQL database integration.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database_name>
CMS_DATABASE_URL=postgresql+psycopg2://postgres:password@db:5432/cms_test_db

# Isolated database schema namespace under which all CMS relational tables are organized.
CMS_DB_SCHEMA=cms
